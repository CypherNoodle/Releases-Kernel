# Optimized config for Samsung NP300E4C (Sandy Bridge)
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_MCORE2=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_HZ_1000=y

# Performance
CONFIG_SCHED_BORE=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# CPU/Power
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_INTEL_IDLE=y
CONFIG_ACPI_PROCESSOR=y

# Bus/Standard
CONFIG_PCI=y
CONFIG_ACPI=y
CONFIG_PNP=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_SD=y

# Samsung Laptop Support
CONFIG_SAMSUNG_LAPTOP=m
CONFIG_SAMSUNG_Q10=m

# Graphics
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# Networking
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=m
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=m

# Input
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_SYNAPTICS=y

# USB
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_USB_STORAGE=m

# Sound
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=m
CONFIG_VFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_TMPFS=y

# Security
CONFIG_FORTIFY_SOURCE=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_RANDOMIZE_BASE=y
